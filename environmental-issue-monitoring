        "def distribute_ambiguous_locations(df: pd.DataFrame) -> Counter:\n",
        "    \"\"\"Distribusikan dokumen berlabel 'Provinsi Tidak Spesifik' (cuma nama pulau\n",
        "    yang kesebut, provinsi-nya tidak) secara proporsional ke provinsi-provinsi\n",
        "    di pulau itu, berbobot jumlah dokumen yang provinsinya sudah pasti.\"\"\"\n",
        "    specific = df[~df[\"Provinsi\"].isin([\"General Seluruh Indonesia\", \"Provinsi Tidak Spesifik\"])]\n",
        "    if specific.empty:\n",
        "        return Counter()\n",
        "\n",
        "    prov_counts = specific.groupby([\"Pulau\", \"Provinsi\"]).size()\n",
        "\n",
        "    ambiguous = df[df[\"Provinsi\"] == \"Provinsi Tidak Spesifik\"]\n",
        "    ambiguous_counts_per_pulau = ambiguous.groupby(\"Pulau\").size()\n",
        "\n",
        "    extra_counts = Counter()\n",
        "    for pulau, amb_count in ambiguous_counts_per_pulau.items():\n",
        "        if pulau not in prov_counts.index.get_level_values(0):\n",
        "            continue\n",
        "\n",
        "        prov_weights = prov_counts.loc[pulau]\n",
        "        proportions = prov_weights / prov_weights.sum()\n",
        "        raw = proportions * amb_count\n",
        "        floor_vals = raw.apply(int)\n",
        "        remainder = int(amb_count - floor_vals.sum())\n",
        "\n",
        "        # sisa pembulatan dikasih ke provinsi dengan sisa desimal terbesar\n",
        "        order = (raw - floor_vals).sort_values(ascending=False).index\n",
        "        alloc = floor_vals.copy()\n",
        "        for prov in order[:remainder]:\n",
        "            alloc[prov] += 1\n",
        "\n",
        "        for prov, add in alloc.items():\n",
        "            extra_counts[prov] += int(add)\n",
        "\n",
        "    return extra_counts\n",
        "\n",
        "\n",
        "SOCIAL_MEDIA_DOMAINS = [\n",
        "    \"facebook.com\", \"fb.watch\", \"instagram.com\", \"twitter.com\", \"x.com\",\n",
        "    \"tiktok.com\", \"youtube.com\", \"youtu.be\", \"threads.net\", \"linkedin.com\",\n",
        "    \"telegram.org\", \"t.me\", \"reddit.com\",\n",
        "]\n",
        "\n",
        "\n",
        "def classify_link_type(link: str) -> str:\n",
        "    \"\"\"Klasifikasi tautan ke kategori Berita atau Media Sosial.\"\"\"\n",
        "    link_str = str(link).lower()\n",
        "    if any(domain in link_str for domain in SOCIAL_MEDIA_DOMAINS):\n",
        "        return \"Media Sosial\"\n",
        "    if link_str.startswith(\"http\"):\n",
        "        return \"Berita\"\n",
        "    return \"Tidak Diketahui\"\n",
        "\n",
        "\n",
        "MEDIA_MAP = {\n",
        "    \"detikcom\": \"Detik.com\", \"detik\": \"Detik.com\",\n",
        "    \"kompas\": \"Kompas.com\", \"kompascom\": \"Kompas.com\",\n",
        "    \"liputan6\": \"Liputan6.com\", \"liputan 6\": \"Liputan6.com\",\n",
        "    \"tribunnews\": \"Tribunnews.com\", \"tribun\": \"Tribunnews.com\",\n",
        "    \"antaranews\": \"Antara News\", \"antara\": \"Antara News\",\n",
        "    \"kumparan\": \"Kumparan.com\",\n",
        "    \"suaracom\": \"Suara.com\", \"suara\": \"Suara.com\",\n",
        "    \"tempo\": \"Tempo.co\", \"tempoco\": \"Tempo.co\",\n",
        "    \"merdekacom\": \"Merdeka.com\", \"merdeka\": \"Merdeka.com\",\n",
        "    \"vivanews\": \"Viva.co.id\", \"vivacoid\": \"Viva.co.id\",\n",
        "    \"okezone\": \"Okezone.com\",\n",
        "    \"sindonews\": \"Sindonews.com\",\n",
        "}\n",
        "\n",
        "if \"Media\" in df_clean.columns:\n",
        "    df_clean[\"Media\"] = df_clean[\"Media\"].replace(MEDIA_MAP)\n",
        "\n",
        "n_docs = len(df_clean)\n",
        "print(f\"[INFO] Memproses {n_docs} dokumen...\")\n",
        "\n",
        "# A. Klasifikasi Isu Inti\n",
        "t0 = time.time()\n",
        "df_clean[\"Isu_Inti\"] = df_clean[\"search_text\"].progress_apply(classify_issue)\n",
        "print(f\"[INFO] Klasifikasi isu selesai dalam {time.time() - t0:.2f} detik\")\n",
        "\n",
        "# B. Ekstraksi Lokasi & Pulau — resolver resmi great.geo (bukan gazetteer manual)\n",
        "t0 = time.time()\n",
        "df_clean[[\"Provinsi\", \"Pulau\"]] = resolve_frame(\n",
        "    df_clean,\n",
        "    location_col=\"Location\",\n",
        "    text_cols=(\"Headline\", \"clean_text\"),\n",
        ")\n",
        "\n",
        "# Rename label bawaan library (\"Tidak Terdeteksi\") -> istilah laporan sendiri\n",
        "df_clean[\"Provinsi\"] = df_clean[\"Provinsi\"].replace(\"Tidak Terdeteksi\", \"General Seluruh Indonesia\")\n",
        "df_clean[\"Pulau\"] = df_clean[\"Pulau\"].replace(\"Tidak Terdeteksi\", \"General Seluruh Indonesia\")\n",
        "FOREIGN_NOISE_KEYWORDS = [\n",
        "    # kota/situs Iran-Israel yang belum ke-cover\n",
        "    \"dimona\", \"arad\", \"alborz\", \"isfahan\", \"karaj\", \"kangan\",\n",
        "    \"nesher\", \"haifa\", \"minab\", \"negev\", \"beirut\", \"hizbullah\",\n",
        "    # Kuba\n",
        "    \"havana\",\n",
        "    # negara/kota lain yang muncul di konteks non-Indonesia\n",
        "    \"filipina\", \"jepang\", \"tokyo\", \"india\", \"new delhi\",\n",
        "    \"china\", \"tiongkok\", \"beijing\", \"qingdao\",\n",
        "     # AS\n",
        "    \"spokane\", \"washington\", \"british columbia\", \"vancouver island\", \"port alberni\",\n",
        "    # Aljazair\n",
        "    \"aljazair\", \"aljir\", \"jijel\",\n",
        "    # China\n",
        "    \"henan\", \"yunnan\", \"zhejiang\", \"jiangsu\", \"wuxi\", \"luohe\",\n",
        "    # Korea Selatan\n",
        "    \"gyeongsang\",\n",
        "    # Eropa\n",
        "    \"italia\", \"verona\", \"roma\", \"belanda\", \"limburg\", \"amsterdam\",\n",
        "    \"yunani\", \"athena\", \"megara\", \"spanyol\", \"castellon\", \"avila\", \"la adrada\",\n",
        "]\n",
        "FOREIGN_NOISE_PATTERN = re.compile(\n",
        "    r\"\\b(\" + \"|\".join(re.escape(k) for k in FOREIGN_NOISE_KEYWORDS) + r\")\\b\",\n",
        "    re.IGNORECASE,\n",
        ")\n",
        "\n",
        "# sinyal domestik: kalau kata \"indonesia\" ada, jangan override -- bisa aja artikel\n",
        "# soal sikap/dampak ke Indonesia atas krisis asing, itu tetap relevan.\n",
        "INDONESIA_SIGNAL_PATTERN = re.compile(r\"\\bindonesia\\b\", re.IGNORECASE)\n",
        "\n",
        "def flag_foreign_noise(row) -> bool:\n",
        "    if row[\"Pulau\"] != \"General Seluruh Indonesia\":\n",
        "        return False  # lokasi Indonesia kedetek -> bukan kandidat noise asing\n",
        "    text = f\"{row.get('Headline', '')} {row.get('clean_text', '')}\"\n",
        "    if not FOREIGN_NOISE_PATTERN.search(text):\n",
        "        return False\n",
        "    if INDONESIA_SIGNAL_PATTERN.search(text):\n",
        "        return False  # nyebut Indonesia -> biarin, jangan override\n",
        "    return True\n",
        "\n",
        "noise_mask = df_clean.apply(flag_foreign_noise, axis=1)\n",
        "n_overridden = int((noise_mask & (df_clean[\"Isu_Inti\"] != \"Noise/Tidak Relevan\")).sum())\n",
        "df_clean.loc[noise_mask, \"Isu_Inti\"] = \"Noise/Tidak Relevan\"\n",
        "\n",
        "print(f\"[INFO] Geo-gate: {n_overridden} baris di-override jadi 'Noise/Tidak Relevan' \"\n",
        "      f\"(dari total {int(noise_mask.sum())} kandidat noise asing terdeteksi)\")\n",
        "print(f\"[INFO] Ekstraksi lokasi selesai dalam {time.time() - t0:.2f} detik\")\n",
        "\n",
        "# C. Klasifikasi Tipe Link\n",
        "if \"Link\" in df_clean.columns:\n",
        "    df_clean[\"Tipe_Link\"] = df_clean[\"Link\"].apply(classify_link_type)\n",
        "\n",
        "# D. Ringkasan Statistik\n",
