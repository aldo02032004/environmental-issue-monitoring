        "            ha = \"right\" if is_dark else \"left\"\n",
        "            ax2.text(\n",
        "                text_x, y_pos, f\"{int(value)}\", va=\"center\", ha=ha,\n",
        "                fontsize=10, fontweight=\"bold\", color=text_color,\n",
        "            )\n",
        "\n",
        "        # --- bar isu tertinggi: dipecah per provinsi (stacked + gradasi) ---\n",
        "        UNDETECTED_LABEL = \"TIDAK DIKETAHUI\"  # sesuai output _normalize_data_name\n",
        "\n",
        "        subset_top = data.loc[data[\"Isu_Inti\"] == top_issue, \"Provinsi\"].dropna() if \"Provinsi\" in data.columns else pd.Series(dtype=object)\n",
        "\n",
        "        if subset_top.empty:\n",
        "            value = counts[top_issue]\n",
        "            ax2.barh(top_y, value, color=cmap(norm(value)), height=0.7)\n",
        "            ax2.text(value + max_value * 0.015, top_y, f\"{int(value)}\", va=\"center\",\n",
        "                      fontsize=10, fontweight=\"bold\", color=\"black\")\n",
        "        else:\n",
        "            # pakai _normalize_data_name konsisten dengan _get_aggs/_get_island_aggs\n",
        "            prov_counts_raw = subset_top.apply(_normalize_data_name).value_counts().sort_values(ascending=False)\n",
        "\n",
        "            prov_counts = prov_counts_raw[prov_counts_raw.index != UNDETECTED_LABEL]\n",
        "            undetected_count = prov_counts_raw.get(UNDETECTED_LABEL, 0)\n",
        "\n",
        "            if prov_counts.empty:\n",
        "                # semua baris gagal normalize — fallback ke bar polos, hindari IndexError di bawah\n",
        "                value = counts[top_issue]\n",
        "                ax2.barh(top_y, value, color=cmap(norm(value)), height=0.7)\n",
        "                ax2.text(value + max_value * 0.015, top_y, f\"{int(value)}\", va=\"center\",\n",
        "                          fontsize=10, fontweight=\"bold\", color=\"black\")\n",
        "            else:\n",
        "                if len(prov_counts) > TOP_N_PROVINSI_DETAIL:\n",
        "                    prov_display = prov_counts.iloc[:TOP_N_PROVINSI_DETAIL].copy()\n",
        "                    lainnya_total = prov_counts.iloc[TOP_N_PROVINSI_DETAIL:].sum() + undetected_count\n",
        "                else:\n",
        "                    prov_display = prov_counts.copy()\n",
        "                    lainnya_total = undetected_count\n",
        "\n",
        "                if lainnya_total > 0:\n",
        "                    prov_display[\"Lainnya\"] = lainnya_total\n",
        "\n",
        "                total_top = prov_display.sum()\n",
        "                max_seg = prov_counts.iloc[0]\n",
        "                left = 0.0\n",
        "                for prov, val in prov_display.items():\n",
        "                    if prov == \"Lainnya\":\n",
        "                        seg_color = \"#c9c9c9\"\n",
        "                        shade = 0.0\n",
        "                    else:\n",
        "                        shade = 0.40 + 0.58 * (val / max_seg)\n",
        "                        seg_color = cmap(shade)\n",
        "\n",
        "                    ax2.barh(top_y, val, left=left, color=seg_color, height=0.7,\n",
        "                              edgecolor=\"white\", linewidth=0.9)\n",
        "\n",
        "                    frac = val / total_top\n",
        "                    if frac > 0.03:\n",
        "                        is_dark = shade > 0.55\n",
        "                        txt_color = \"white\" if is_dark else \"#222222\"\n",
        "                        display_name = prov if prov == \"Lainnya\" else prov.title()\n",
        "                        label = f\"{display_name}\\n{int(val)}\" if frac > 0.05 else f\"{int(val)}\"\n",
        "                        ax2.text(left + val / 2, top_y, label, ha=\"center\", va=\"center\",\n",
        "                                  fontsize=9 if frac > 0.05 else 7.5, fontweight=\"bold\", color=txt_color)\n",
        "                    left += val\n",
        "\n",
        "                ax2.text(left + max_value * 0.015, top_y, f\"{int(total_top)}\", va=\"center\",\n",
        "                          fontsize=10, fontweight=\"bold\", color=\"black\")\n",
        "\n",
        "                top_prov_name = prov_counts.index[0].title()\n",
        "                top_prov_val = int(prov_counts.iloc[0])\n",
        "                top_prov_pct = top_prov_val / total_top * 100\n",
        "                ax2.annotate(\n",
        "                    f\"{top_issue}: terbanyak di {top_prov_name}\\n({top_prov_val} kasus, {top_prov_pct:.0f}% dari total)\",\n",
        "                    xy=(top_prov_val / 2, top_y), xytext=(top_prov_val / 2, top_y + 0.85),\n",
        "                    ha=\"center\", va=\"bottom\", fontsize=9.5, fontweight=\"bold\", color=\"#7a0000\",\n",
        "                    arrowprops=dict(arrowstyle=\"-|>\", color=\"#7a0000\", lw=1.2),\n",
        "                )\n",
        "\n",
        "        ax2.set_title(\n",
        "            f\"Distribusi Nasional Isu Lingkungan di Indonesia\\n{_format_period(start_date, end_date)}\",\n",
        "            fontsize=TITLE_SIZE, fontweight=\"bold\", pad=20,\n",
        "        )\n",
        "        ax2.set_xlabel(\"Jumlah Kasus\", fontsize=11, fontweight=\"bold\")\n",
        "        ax2.set_yticks(y_positions)\n",
        "        ax2.set_yticklabels(counts.index)\n",
        "        ax2.set_ylim(-0.6, top_y + 1.1)\n",
        "        ax2.tick_params(axis=\"y\", labelsize=11, length=0)\n",
        "        ax2.spines[[\"top\", \"right\", \"left\"]].set_visible(False)\n",
        "        ax2.xaxis.grid(True, linestyle=\"-\", alpha=0.3, color=\"#e0e0e0\")\n",
        "        ax2.set_axisbelow(True)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "    return fig\n",
        "\n",
        "\n",
        "df_clean, start_date, end_date = prepare_data(df_clean)\n",
        "df_visual = df_clean[df_clean[\"Isu_Inti\"] != \"Noise/Tidak Relevan\"].reset_index(drop=True)\n",
        "fig_combined = plot_combined(df_visual, start_date, end_date)"
      ]
    },
