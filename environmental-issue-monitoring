      "source": [
        "general_subset = df_clean[df_clean[\"Pulau\"] == \"General Seluruh Indonesia\"]\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 1. KANDIDAT ISU / NOISE\n",
        "#    Baris General yang Isu_Inti-nya BUKAN \"Noise/Tidak Relevan\" —\n",
        "#    berarti lolos ISSUE_RULES padahal kandidat noise (geo-gate belum\n",
        "#    nangkep, atau kata pemicu isu ISSUE_RULES ke-trigger tanpa konteks\n",
        "#    Indonesia).\n",
        "# ------------------------------------------------------------------\n",
        "suspect_noise = general_subset[general_subset[\"Isu_Inti\"] != \"Noise/Tidak Relevan\"]\n",
        "print(f\"Kandidat noise yang lolos jadi isu valid: {len(suspect_noise)} baris\\n\")\n",
        "\n",
        "known_noise_words = {w.lower() for w in FOREIGN_NOISE_KEYWORDS}\n",
        "\n",
        "print(\"Top kata (kandidat baru FOREIGN_NOISE_KEYWORDS / exclude ISSUE_RULES):\")\n",
        "for w, c in top_terms(suspect_noise[\"search_text\"], n=30, ngram=1):\n",
        "    if w not in known_noise_words:\n",
        "        print(f\"  {w}: {c}\")\n",
        "\n",
        "print(\"\\nTop frasa 2 kata:\")\n",
        "for p, c in top_terms(suspect_noise[\"search_text\"], n=20, ngram=2):\n",
        "    if not any(word in known_noise_words for word in p.split()):\n",
        "        print(f\"  {p}: {c}\")\n",
        "\n",
        "sample = suspect_noise.sample(min(15, len(suspect_noise)), random_state=1)\n",
        "print(\"\\nSample baca manual (konfirmasi konteks, bukan cuma kata kunci lepas):\")\n",
        "for i, row in sample.iterrows():\n",
        "    print(f\"--- {i} | {row['Isu_Inti']} ---\")\n",
        "    print(str(row['Mentions'])[:200])\n",
        "    print()\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 2. KANDIDAT LOKASI\n",
        "#    Baris General yang teksnya ADA pola \"Kabupaten/Kota/Kec./Provinsi X\"\n",
        "#    tapi resolve_frame gagal cocokin -> X belum ada di gazetteer great.geo.\n",
        "#    Dikumpulin per-nama + frekuensi, bukan raw list 30 baris pertama —\n",
        "#    biar nama yang sering muncul kelihatan duluan, bukan urutan index.\n",
        "# ------------------------------------------------------------------\n",
        "loc_pattern = re.compile(\n",
        "    r'\\b(?:kabupaten|kota|kec\\.|kecamatan|provinsi)\\s+([a-z]+(?:\\s+[a-z]+)?)',\n",
        "    re.IGNORECASE,\n",
        ")\n",
        "\n",
        "loc_candidates = Counter()\n",
        "loc_examples = {}\n",
        "for idx, txt in general_subset[\"Mentions\"].dropna().items():\n",
        "    for name in loc_pattern.findall(str(txt)):\n",
        "        key = name.strip().lower()\n",
        "        loc_candidates[key] += 1\n",
        "        loc_examples.setdefault(key, (idx, str(txt)[:200]))\n",
        "\n",
        "print(f\"\\nKandidat nama daerah belum ke-gazetteer: {len(loc_candidates)} nama unik, \"\n",
        "      f\"{sum(loc_candidates.values())} total kemunculan\\n\")\n",
        "for name, count in loc_candidates.most_common(30):\n",
        "    idx, snippet = loc_examples[name]\n",
        "    print(f\"{name} ({count}x) — contoh DOC index {idx}:\\n  {snippet}\\n\")\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# 3. KANDIDAT FOREIGN_NOISE_KEYWORDS\n",
        "#    Proper noun (Title Case di teks asli, sebelum di-lowercase) yang\n",
        "#    sering muncul di suspect_noise tapi belum ke-cover FOREIGN_NOISE_KEYWORDS.\n",
        "#    Heuristik kapitalisasi doang, BUKAN cek gazetteer -> tetap wajib\n",
        "#    direview manual sebelum ditambah ke list resmi (nama orang Indonesia,\n",
        "#    nama media, nama institusi lokal bisa ikut ke-tangkep juga).\n",
        "# ------------------------------------------------------------------\n",
        "PROPER_NOUN_PATTERN = re.compile(r'\\b[A-Z][a-zA-Z]{2,}\\b')\n",
        "COMMON_CAPITALIZED_NOISE = {\n",
        "    \"Indonesia\", \"Presiden\", \"Menteri\", \"Pemerintah\", \"Foto\", \"Sumber\",\n",
        "    \"ANTARA\", \"REPUBLIKA\", \"KOMPAS\", \"Dok\",\n",
        "}\n",
        "\n",
        "proper_noun_counts = Counter()\n",
        "for txt in suspect_noise[\"Mentions\"].dropna():\n",
        "    words = PROPER_NOUN_PATTERN.findall(str(txt))\n",
        "    proper_noun_counts.update(\n",
        "        w for w in words\n",
        "        if w not in COMMON_CAPITALIZED_NOISE and w.lower() not in known_noise_words\n",
        "    )\n",
        "\n",
        "print(\"\\nKandidat FOREIGN_NOISE_KEYWORDS baru (review manual dulu sebelum dipakai):\")\n",
        "for name, count in proper_noun_counts.most_common(30):\n",
        "    print(f\"  {name}: {count}\")"
