        "    # supaya terlihat provinsi mana penyumbang terbesar dari isu tersebut.\n",
        "    TOP_N_PROVINSI_DETAIL = 6  # provinsi individual yang ditampilkan; sisanya digabung \"Lainnya\"\n",
        "\n",
        "    if \"Isu_Inti\" not in data.columns or data[\"Isu_Inti\"].dropna().empty:\n",
