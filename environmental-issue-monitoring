        "        else:\n",
        "            print(\"[WARNING] Tidak ada data pulau yang bisa dipetakan, chart per pulau dilewati.\")\n",
        "            ax_pulau.axis(\"off\")\n",
        "    else:\n",
        "        ax_pulau.axis(\"off\")\n",
        "\n",
        "    plt.subplots_adjust(left=0.02, right=0.98, top=0.9, bottom=0.05)\n",
        "    plt.show()\n",
        "    return fig\n",
        "\n",
        "df_clean, start_date, end_date = prepare_data(df_clean)\n",
